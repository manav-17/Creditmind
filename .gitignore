# ===== Secrets (NEVER commit) =====
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json

# ===== Data =====
# Raw and processed datasets stay local (too large).
# Only the small synthetic demo set is committed (its personal details are fake).
data/raw/
data/processed/*
!data/processed/applications_demo.csv
*.csv
!data/processed/applications_demo.csv

# ===== Model artifacts =====
# Small trained artifacts ARE committed so the app can deploy from GitHub.
models/*
!models/xgb_model.json
!models/calibrator.joblib
!models/model_config.json
vectorstore/*
!vectorstore/policy.faiss
!vectorstore/policy_clauses.json
*.pkl
*.bin

# ===== Python =====
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ===== Frontend (React) =====
node_modules/
web/dist/

# ===== Generated output =====
outputs/
logs/
*.log
tmp/

# ===== OS / editor =====
.DS_Store
.vscode/
.idea/