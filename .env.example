# ---------------------------------------------------------------------------
# CreditMind configuration template
# Copy this file to .env and fill in your own values. Never commit .env.
# On Railway, set the same variables in each service's Variables tab.
# ---------------------------------------------------------------------------

# --- LLM: primary provider (Groq) ---
GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_STRONG=openai/gpt-oss-120b

# --- LLM: backup provider (Google Gemini) - optional, enables automatic failover ---
GOOGLE_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.5-flash

# --- Observability (Langfuse) - optional, the pipeline runs without it ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region: https://cloud.langfuse.com  |  US region: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Database (Postgres) - required for the API ---
# Local: docker compose up -d db   |   Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://creditmind:creditmind@localhost:5432/creditmind

# --- Authentication - leave empty locally to keep the API open ---
# Officer login password for the dashboard
DASHBOARD_PASSWORD=
# Random secret for signing login tokens: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
# Optional key for scripts calling the API directly (X-API-Key header)
API_KEY=

# --- CORS: comma-separated frontend URLs allowed to call the API ---
CORS_ORIGINS=http://localhost:5173