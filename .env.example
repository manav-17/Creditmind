# ---------------------------------------------------------------------------
# CreditMind configuration template
# Copy this file to .env and fill in your own values. Never commit .env.
# ---------------------------------------------------------------------------

# --- LLM: primary provider (Groq) ---
GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_STRONG=openai/gpt-oss-120b

# --- LLM: backup provider (Google Gemini) - optional, enables automatic failover ---
GOOGLE_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.5-flash

# --- Observability (Langfuse) - optional, the pipeline runs without it ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region: https://cloud.langfuse.com  |  US region: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Database (Postgres) - required for the API ---
# Local (docker compose up -d db):
DATABASE_URL=postgresql://creditmind:creditmind@localhost:5432/creditmind

# --- API security - optional; when set, every API call needs the X-API-Key header ---
API_KEY=

# --- Dashboard ---
API_URL=http://localhost:8000